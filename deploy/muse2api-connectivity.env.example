# Actual production values for the /home/muse2api deployment.
MUSE2API_SERVICE=muse2api-python.service
MUSE2API_HEALTH_URL=http://127.0.0.1:18610/healthz
MUSE2API_HATCH_URL=https://hatch.metaaivm.com/v1/noise
MUSE2API_HATCH_HOST=hatch.metaaivm.com
MUSE2API_DNS_INTERFACE=eth0
MUSE2API_DNS_SERVERS="1.1.1.1 8.8.8.8"
MUSE2API_AUTO_REPAIR=1
MUSE2API_RESTART_ON_RECOVERY=1
# 本地健康检查连续失败 3 次才触发服务重启，避免瞬时抖动导致重启
MUSE2API_LOCAL_HEALTH_FAILURES=3
MUSE2API_LOCAL_HEALTH_INTERVAL=3
# 重启后最多等待 60 秒恢复；两次自动重启至少间隔 10 分钟
MUSE2API_RESTART_WAIT_SECONDS=60
MUSE2API_RESTART_COOLDOWN_SECONDS=600
